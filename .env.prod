# ═══════════════════════════════════════════════════════════════
# Production Environment Configuration
# Copy this file to .env.prod (project root) and fill in all values.
# This file is read by docker-compose for the backend service.
# ═══════════════════════════════════════════════════════════════

# ── App ──
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=WARNING

# ── Database (PostgreSQL) ──
# Set by docker-compose; override here if using external PostgreSQL
# DATABASE_URL=postgresql+asyncpg://user:pass@db:5432/novel_agent

# ── CORS ──
# Only allow your production domains (comma-separated)
CORS_ORIGINS=https://your-domain.com

# ── Rate Limiting ──
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_LLM=10/minute
# For multi-process deployments, use Redis:
# RATE_LIMIT_STORAGE_URI=redis://redis:6379

# ── JWT ──
# MUST be set to a secure random string!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# ── LLM API (optional — can also be configured via UI) ──
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# ── Sentry (optional — leave empty to disable) ──
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_SEND_PII=false
