# Production environment — DEBUG disabled, strict settings
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Database — use PostgreSQL in production
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/novel_agent

# CORS — only allow your production domains
# CORS_ORIGINS=https://your-domain.com

# Logging
LOG_LEVEL=WARNING

# Rate limiting (strict for prod)
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_LLM=10/minute
