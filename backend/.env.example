# ===== App =====
APP_NAME=小说世界观续写 Agent
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ===== Database =====
# SQLite (dev): sqlite+aiosqlite:///./data/novel_agent.db
# PostgreSQL (prod): postgresql+asyncpg://user:pass@localhost:5432/novel_agent
DATABASE_URL=sqlite+aiosqlite:///./data/novel_agent.db

# ===== LLM API =====
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ===== CORS =====
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== File Upload =====
MAX_UPLOAD_SIZE=10485760

# ===== Rate Limiting =====
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_LLM=10/minute
# Use Redis for multi-process: redis://localhost:6379
RATE_LIMIT_STORAGE_URI=memory://

# ===== Auth / JWT =====
# IMPORTANT: Set this to a secure random string in production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# In DEBUG mode, an insecure default is used if not set.
# In production, the app will refuse to start if not set.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# ===== Sentry (Error Monitoring) =====
# Leave empty to disable. Get your DSN at https://sentry.io/
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Set to true to send PII (email, username) to Sentry — disabled by default for privacy
SENTRY_SEND_PII=false

# ===== Logging =====
LOG_LEVEL=INFO

# ===== Environment Selection =====
# Set ENV_FILE to specify which .env file to load
# ENV_FILE=.env.dev for development, ENV_FILE=.env.prod for production
# Default: .env
# ENV_FILE=.env
