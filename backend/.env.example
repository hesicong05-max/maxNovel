# ===== App =====
APP_NAME=小说世界观续写 Agent
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ===== Database =====
# SQLite (dev): sqlite+aiosqlite:///./data/novel_agent.db
# PostgreSQL (prod): postgresql+asyncpg://user:pass@localhost:5432/novel_agent
DATABASE_URL=sqlite+aiosqlite:///./data/novel_agent.db

# ===== LLM API =====
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# ===== CORS =====
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== File Upload =====
MAX_UPLOAD_SIZE=10485760

# ===== Rate Limiting =====
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_LLM=10/minute

# ===== Logging =====
LOG_LEVEL=INFO
