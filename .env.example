# ═══════════════════════════════════════════════════════════════
# Docker Compose Environment File
# Copy this file to .env and fill in all values before deployment.
# This file provides variables for docker-compose interpolation.
# ═══════════════════════════════════════════════════════════════

# ── PostgreSQL ──
DB_USER=novel_user
DB_PASSWORD=change-me-to-a-strong-password

# ── JWT Secret ──
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# ── Sentry (optional) ──
SENTRY_DSN=
VITE_SENTRY_DSN=
